+// JXL-SZI patch: AC passes from the environment, for files whose longest entropy-coded
+// stream (one pass of one 256x256 group) is shorter, which is what a GPU decoder waits for. JXL_SZI_PASSES is a
+// comma-separated list of num_coefficients[:shift] (e.g. "3,5,8": the 3x3, 5x5 and 8x8 squares of each 8x8 area),
+// non-decreasing, ending in 8 with shift 0. Unset: libjxl as released. Every pass still uses libjxl's own per-pass
+// coefficient order (positions that are always zero in a pass go last and are never coded), so the files are
+// ordinary progressive JPEG XL.
+static bool SziPassesFromEnv(ProgressiveMode* mode) {
+  const char* spec = nullptr;
+#ifdef _MSC_VER
+  char* buf = nullptr;
+  size_t len = 0;
+  if (_dupenv_s(&buf, &len, "JXL_SZI_PASSES") != 0 || buf == nullptr) return false;
+  std::string s(buf);
+  free(buf);
+  spec = s.c_str();
+#else
+  spec = std::getenv("JXL_SZI_PASSES");
+  if (spec == nullptr) return false;
+  std::string s(spec);
+  spec = s.c_str();
+#endif
+  ProgressiveMode m;
+  m.num_passes = 0;
+  size_t prev_n = 1, prev_shift = 0;
+  for (const char* p = spec; *p != '\0';) {
+    char* end = nullptr;
+    size_t n = std::strtoul(p, &end, 10);
+    size_t shift = 0;
+    if (end == p) return false;
+    p = end;
+    if (*p == ':') {
+      shift = std::strtoul(p + 1, &end, 10);
+      p = end;
+    }
+    if (*p == ',') p++;
+    if (n < 2 || n > 8 || m.num_passes >= kMaxNumPasses) return false;
+    if (!(n > prev_n || (n == prev_n && shift < prev_shift))) return false;
+    m.passes[m.num_passes++] = PassDefinition{n, shift, kNoDownsamplingFactor};
+    prev_n = n;
+    prev_shift = shift;
+  }
+  if (m.num_passes == 0 || prev_n != 8 || prev_shift != 0) return false;
+  m.passes[m.num_passes - 1].suitable_for_downsampling_of_at_least = 0;
+  *mode = m;
+  return true;
+}
